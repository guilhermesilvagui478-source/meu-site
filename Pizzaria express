<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pizza Express | Praia Grande</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,500;9..144,600;9..144,700&family=Manrope:wght@400;500;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#130d0a;
  --surface:#1e1512;
  --surface-2:#271b16;
  --fire:#e85d2c;
  --ember:#c1272d;
  --gold:#f2a93c;
  --cream:#f5e8d8;
  --cream-dim:#cabcac;
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  background:var(--ink);
  color:var(--cream);
  font-family:'Manrope',sans-serif;
  overflow-x:hidden;
}
h1,h2,h3,.display{font-family:'Fraunces',serif;}
.mono{font-family:'IBM Plex Mono',monospace;}
a{color:inherit;text-decoration:none;}
img{max-width:100%;display:block;}

/* ---------- reduced motion ---------- */
@media (prefers-reduced-motion: reduce){
  *{animation-duration:0.001ms !important; animation-iteration-count:1 !important; scroll-behavior:auto !important;}
}

/* ---------- header ---------- */
header{
  position:fixed; top:0; left:0; right:0; z-index:100;
  display:flex; align-items:center; justify-content:space-between;
  padding:18px 5%;
  transition:background .3s ease, box-shadow .3s ease, padding .3s ease;
}
header.scrolled{
  background:rgba(19,13,10,0.92);
  backdrop-filter:blur(8px);
  box-shadow:0 4px 24px rgba(0,0,0,.35);
  padding:10px 5%;
}
.brand{display:flex;align-items:center;gap:12px;}
.brand img{width:46px;height:46px;border-radius:50%;object-fit:cover;}
.brand span{font-family:'Fraunces',serif;font-weight:700;font-size:1.15rem;letter-spacing:.3px;}
nav{display:flex;gap:34px;font-size:.92rem;font-weight:500;}
nav a{position:relative;opacity:.88;transition:opacity .2s;}
nav a:hover{opacity:1;}
nav a::after{content:'';position:absolute;left:0;bottom:-6px;width:0;height:1.5px;background:var(--fire);transition:width .25s ease;}
nav a:hover::after{width:100%;}
.nav-cta{
  display:flex;align-items:center;gap:8px;
  background:linear-gradient(135deg,var(--fire),var(--ember));
  padding:10px 20px;border-radius:100px;font-weight:700;font-size:.88rem;
  box-shadow:0 6px 18px rgba(232,93,44,.35);
  transition:transform .2s ease;
}
.nav-cta:hover{transform:translateY(-2px);}
.menu-toggle{display:none;}

/* ---------- hero ---------- */
.hero{
  position:relative; height:100svh; min-height:560px;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  text-align:center; overflow:hidden;
}
.hero video{
  position:absolute; top:50%; left:50%; min-width:100%; min-height:100%;
  width:auto; height:auto; transform:translate(-50%,-50%);
  object-fit:cover; z-index:0; filter:brightness(.62) saturate(1.15);
}
.hero::after{
  content:'';position:absolute;inset:0;z-index:1;
  background:
    radial-gradient(ellipse at 50% 30%, rgba(19,13,10,0.15), rgba(19,13,10,0.75) 65%),
    linear-gradient(180deg, rgba(19,13,10,.55) 0%, rgba(19,13,10,.25) 30%, rgba(19,13,10,.85) 100%);
}
.hero-content{position:relative;z-index:2;max-width:840px;padding:110px 24px 96px;}
.badge-rating{
  display:inline-flex;align-items:center;gap:8px;
  background:rgba(245,232,216,.1);border:1px solid rgba(245,232,216,.25);
  padding:7px 16px;border-radius:100px;font-size:.82rem;margin-bottom:26px;
  backdrop-filter:blur(4px);
}
.badge-rating .stars{color:var(--gold);letter-spacing:1px;}
.hero h1{
  font-size:clamp(2.6rem,6.5vw,5.2rem);
  line-height:1.02; font-weight:600; font-optical-sizing:auto;
  letter-spacing:-.02em;
  margin-bottom:22px;
}
.hero h1 .drip{
  color:var(--fire);
  font-style:italic; font-weight:500;
  text-shadow:0 6px 22px rgba(232,93,44,.45);
}
.hero p.sub{
  font-size:clamp(1rem,1.6vw,1.2rem); color:var(--cream-dim);
  max-width:520px;margin:0 auto 38px;line-height:1.55;
}
.hero-ctas{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;}
.btn-primary{
  display:inline-flex;align-items:center;gap:10px;
  background:linear-gradient(135deg,var(--fire),var(--ember));
  color:var(--cream); padding:17px 34px;border-radius:100px;
  font-weight:800;font-size:1rem;letter-spacing:.2px;
  box-shadow:0 10px 30px rgba(232,93,44,.4);
  transition:transform .25s ease, box-shadow .25s ease;
}
.btn-primary:hover{transform:translateY(-3px);box-shadow:0 14px 36px rgba(232,93,44,.55);}
.btn-ghost{
  display:inline-flex;align-items:center;gap:8px;
  border:1px solid rgba(245,232,216,.3);color:var(--cream);
  padding:16px 30px;border-radius:100px;font-weight:600;font-size:.95rem;
  transition:background .25s ease, border-color .25s ease;
}
.btn-ghost:hover{background:rgba(245,232,216,.08);border-color:rgba(245,232,216,.55);}
.scroll-cue{
  position:absolute;bottom:28px;left:50%;transform:translateX(-50%);z-index:2;
  font-size:.72rem;letter-spacing:.18em;color:var(--cream-dim);
  display:flex;flex-direction:column;align-items:center;gap:8px;
  text-transform:uppercase;
}
.scroll-cue .line{width:1px;height:34px;background:linear-gradient(var(--cream-dim),transparent);animation:pulse-line 1.8s ease-in-out infinite;}
@keyframes pulse-line{0%,100%{opacity:.25;}50%{opacity:1;}}

/* ---------- marquee signature ---------- */
.marquee{
  background:var(--fire);
  color:var(--ink);
  overflow:hidden;white-space:nowrap;
  padding:14px 0;
  border-top:1px solid rgba(0,0,0,.15);
  border-bottom:1px solid rgba(0,0,0,.15);
}
.marquee-track{
  display:inline-flex;gap:0;
  animation:scroll-left 26s linear infinite;
}
.marquee span{
  font-family:'IBM Plex Mono',monospace;
  font-weight:600;font-size:.95rem;letter-spacing:.12em;
  padding:0 22px;text-transform:uppercase;
  display:inline-flex;align-items:center;gap:22px;
}
.marquee span::after{content:'\2726';font-size:.7rem;opacity:.6;}
@keyframes scroll-left{from{transform:translateX(0);}to{transform:translateX(-50%);}}

/* ---------- section shell ---------- */
section{padding:110px 5%;position:relative;}
.eyebrow{
  font-family:'IBM Plex Mono',monospace;color:var(--fire);
  font-size:.78rem;letter-spacing:.2em;text-transform:uppercase;
  margin-bottom:16px;display:flex;align-items:center;gap:10px;
}
.eyebrow::before{content:'';width:26px;height:1px;background:var(--fire);}
.section-title{font-size:clamp(1.9rem,3.6vw,3rem);font-weight:600;line-height:1.1;letter-spacing:-.01em;}

/* ---------- about ---------- */
.about{
  display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;
  max-width:1200px;margin:0 auto;
}
.about-img{position:relative;border-radius:18px;overflow:hidden;box-shadow:0 30px 60px rgba(0,0,0,.5);}
.about-img img,.about-img video{aspect-ratio:4/5;object-fit:cover;width:100%;transition:transform .6s ease;}
.about-img:hover img,.about-img:hover video{transform:scale(1.04);}
.about-img .tag{
  position:absolute;bottom:18px;left:18px;
  background:rgba(19,13,10,.75);backdrop-filter:blur(6px);
  border:1px solid rgba(245,232,216,.2);
  padding:10px 16px;border-radius:10px;font-size:.8rem;
  font-family:'IBM Plex Mono',monospace;
}
.about-text p{color:var(--cream-dim);line-height:1.8;font-size:1.02rem;margin:22px 0 30px;}
.stat-row{display:flex;gap:44px;margin-top:12px;}
.stat b{display:block;font-family:'Fraunces',serif;font-size:2.1rem;color:var(--gold);font-weight:600;}
.stat span{font-size:.8rem;color:var(--cream-dim);}

/* ---------- menu ---------- */
.menu-section{background:var(--surface);}
.menu-head{text-align:center;max-width:640px;margin:0 auto 50px;}
.menu-head .section-title{margin-top:14px;}
.tabs{
  display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin:40px 0 46px;
}
.tab-btn{
  font-family:'IBM Plex Mono',monospace;font-size:.85rem;font-weight:500;
  padding:11px 22px;border-radius:100px;border:1px solid rgba(245,232,216,.2);
  color:var(--cream-dim);cursor:pointer;background:transparent;
  transition:all .25s ease;
}
.tab-btn.active,.tab-btn:hover{
  background:var(--fire);border-color:var(--fire);color:var(--ink);font-weight:600;
}
.menu-panel{display:none;max-width:840px;margin:0 auto;}
.menu-panel.active{display:block;animation:fade-up .5s ease;}
@keyframes fade-up{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:translateY(0);}}
.menu-item{
  display:flex;justify-content:space-between;gap:20px;align-items:baseline;
  padding:22px 0;border-bottom:1px dashed rgba(245,232,216,.18);
}
.menu-item:last-child{border-bottom:none;}
.menu-item-name{font-family:'Fraunces',serif;font-size:1.2rem;font-weight:600;}
.menu-item-desc{color:var(--cream-dim);font-size:.88rem;margin-top:5px;max-width:480px;line-height:1.5;}
.menu-item-price{
  font-family:'IBM Plex Mono',monospace;color:var(--gold);font-weight:600;
  white-space:nowrap;font-size:1.05rem;
}
.menu-note{
  text-align:center;margin-top:38px;font-size:.82rem;color:var(--cream-dim);
  font-family:'IBM Plex Mono',monospace;
}

/* ---------- ratings ---------- */
.ratings{
  display:grid;grid-template-columns:.9fr 1.1fr;gap:70px;align-items:center;
  max-width:1200px;margin:0 auto;
}
.rating-big{text-align:center;}
.rating-big .num{font-family:'Fraunces',serif;font-size:7rem;font-weight:600;line-height:1;color:var(--gold);}
.rating-big .stars-lg{color:var(--gold);font-size:1.6rem;letter-spacing:6px;margin:14px 0;}
.rating-big p{color:var(--cream-dim);font-size:.9rem;}
.quote{
  font-family:'Fraunces',serif;font-size:clamp(1.3rem,2.4vw,1.9rem);
  font-style:italic;line-height:1.5;color:var(--cream);
  border-left:2px solid var(--fire);padding-left:28px;
}
.quote cite{
  display:block;margin-top:20px;font-family:'Manrope',sans-serif;
  font-style:normal;font-size:.85rem;color:var(--cream-dim);
}

/* ---------- location ---------- */
.location-section{background:var(--surface);}
.loc-grid{
  display:grid;grid-template-columns:1fr 1fr;gap:60px;
  max-width:1100px;margin:0 auto;
}
.info-card{
  background:var(--surface-2);border:1px solid rgba(245,232,216,.08);
  border-radius:18px;padding:36px;
}
.info-card h3{font-size:1.3rem;margin-bottom:18px;display:flex;align-items:center;gap:10px;}
.info-card p{color:var(--cream-dim);line-height:1.75;font-size:.95rem;}
.hours-row{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid rgba(245,232,216,.08);font-size:.92rem;}
.hours-row:last-child{border-bottom:none;}
.hours-row .status{color:var(--gold);font-family:'IBM Plex Mono',monospace;font-size:.78rem;font-weight:600;}

/* ---------- final cta ---------- */
.final-cta{
  text-align:center;background:linear-gradient(180deg,var(--ink) 0%, var(--surface) 100%);
  position:relative;
}
.final-cta::before{
  content:'';position:absolute;inset:0;
  background:radial-gradient(circle at 50% 0%, rgba(232,93,44,.18), transparent 60%);
}
.final-cta-inner{position:relative;max-width:640px;margin:0 auto;}
.final-cta h2{font-size:clamp(2rem,4.5vw,3.2rem);margin-bottom:20px;}
.final-cta p{color:var(--cream-dim);margin-bottom:38px;font-size:1.05rem;}

/* ---------- footer ---------- */
footer{
  padding:50px 5% 30px;border-top:1px solid rgba(245,232,216,.08);
  display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:20px;
}
.footer-brand{display:flex;align-items:center;gap:12px;}
.footer-brand img{width:38px;height:38px;border-radius:50%;}
footer .fine{font-size:.78rem;color:var(--cream-dim);font-family:'IBM Plex Mono',monospace;}

/* ---------- floating whatsapp ---------- */
.float-wa{
  position:fixed;bottom:26px;right:26px;z-index:200;
  width:62px;height:62px;border-radius:50%;
  background:linear-gradient(135deg,var(--fire),var(--ember));
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 10px 30px rgba(232,93,44,.5);
  animation:float-pulse 2.6s ease-in-out infinite;
}
.float-wa svg{width:28px;height:28px;}
@keyframes float-pulse{0%,100%{transform:scale(1);}50%{transform:scale(1.07);}}

/* ---------- responsive ---------- */
@media (max-width:860px){
  nav{display:none;}
  .about,.ratings,.loc-grid{grid-template-columns:1fr;}
  .rating-big .num{font-size:5rem;}
  .stat-row{gap:30px;}
}
@media (max-width:520px){
  section{padding:80px 6%;}
  .hero-content{padding:90px 20px 30px;}
  .hero-ctas{flex-direction:column;width:100%;}
  .btn-primary,.btn-ghost{justify-content:center;}
  .scroll-cue{display:none;}
}
@media (max-height:680px){
  .scroll-cue{display:none;}
}

/* focus visibility */
a:focus-visible, button:focus-visible{outline:2px solid var(--gold);outline-offset:3px;}
</style>
</head>
<body>

<header id="siteHeader">
  <div class="brand">
    <img src="data:image/jpeg;base64,
